# LLM route for scripts/transform.mjs
# opencode    — DeepSeek (or other cheap/free model) via the opencode CLI. Prototyping default.
# claude-cli  — `claude -p` on the existing subscription. Quality benchmarking.
# openrouter  — direct OpenRouter API. Scale-up route; needs OPENROUTER_API_KEY.
LLM_ROUTE=opencode

# Only needed when LLM_ROUTE=openrouter
OPENROUTER_API_KEY=

# Hard ceiling for one transform run (openrouter route only). Raise explicitly
# for the full-catalog scale-up run.
MAX_RUN_USD=1

# PocketBase base URL for newsletter + built-it capture.
# Leave empty during local prototyping: the site degrades to a graceful no-op.
PB_URL=
