---
pagination:
  data: taxonomy.levels
  size: 1
  alias: pathLevel
permalink: "/paths/{{ pathLevel.key }}/"
eleventyComputed:
  title: "{{ pathLevel.label }} path"
---
<h1 style="--size:1.6rem; --size-md:2.1rem">
  <span style="--bg:var(--c-{{ pathLevel.key }}); --c:white; --p:0.1rem 0.6rem; --radius:0.3rem">{{ pathLevel.label }}</span>
  {{ pathLevel.sub }}
</h1>
<p>{{ pathLevel.intro }}</p>

<div data-swap>
<ul style="--lis:none; --p:0; --d:grid; --g:0.8rem">
  {% for lesson in lessons %}
    {% if lesson.overlay.level == pathLevel.key %}
    <li style="--b:1px solid oklch(88% 0.01 250); --radius:0.5rem; --p:0.8rem">
      <p style="--d:flex; --ai:center; --g:0.5rem; --m:0">
        {% if lesson.icon %}<img src="{{ lesson.icon }}" alt="" width="20" height="20" style="--radius:0.25rem; flex-shrink:0" />{% endif %}
        <a href="/lessons/{{ lesson.slug }}/" style="--weight:700">{{ lesson.overlay.title }}</a>
      </p>
      <p style="--size:0.85rem; --m:0.3rem 0 0">{{ lesson.overlay.summary | truncate(140) }}</p>
      <p style="--size:0.75rem; --m:0.3rem 0 0">{{ taxonomy.timeLabels[lesson.overlay.timeEstimate] }} · {{ lesson.entry.category }}</p>
    </li>
    {% endif %}
  {% else %}
    <li>No lessons at this level yet.</li>
  {% endfor %}
</ul>
<p style="--size:0.85rem">
  Other paths:
  {% for l in taxonomy.levels %}{% if l.key != pathLevel.key %}<a href="/paths/{{ l.key }}/">{{ l.label }}</a> {% endif %}{% endfor %}
</p>
</div>
