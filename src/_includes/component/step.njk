{# expects: step, index, slug, labelMeta. progress.js sets data-on when the step is ticked. #}
<article id="step-{{ index }}" data-step-card
         style="{{ ui.card }}; --mb:1rem; --bc-on:var(--c-done); --bgc-on:var(--c-done-bg)">
  <header style="--d:flex; --ai:center; --g:0.6rem; --fw:wrap; --mb:0.5rem">
    <label for="step-box-{{ index }}" style="--d:flex; --ai:center; --g:0.6rem; --weight:700; --cur:pointer">
      <input type="checkbox" id="step-box-{{ index }}" data-step="{{ slug }}:{{ index }}" data-label="{{ step.label }}"
             style="--w:1.6rem; --h:1.6rem; --m:0; --cur:pointer" />
      <span style="{{ ui.chip }}; --bg:{{ labelMeta.color }}">{{ labelMeta.display }}</span>
      <span>{{ index + 1 }}. {{ step.title }}</span>
    </label>
  </header>
  <p style="--mt:0">{{ step.body }}</p>
  <aside style="--p:0.5rem 0.8rem; --bl:3px solid {{ labelMeta.color }}; --size:0.85rem; --fs:italic">
    why {{ labelMeta.display | lower }}: {{ step.why }}
  </aside>
  {% if step.prompt %}
  <details style="--mt:0.6rem">
    <summary>step prompt</summary>
    <pre data-prompt style="--p:0.8rem; --c:black; --bg:var(--c-panel); --radius:0.4rem; --ws:pre-wrap; --ofx:auto">{{ step.prompt }}</pre>
    <button type="button" data-copy-prompt style="{{ ui.button }}">copy prompt</button>
  </details>
  {% endif %}
</article>
