<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}" />
  <meta name="generator" content="Startr" />
  {% if env.pbUrl %}<meta name="pb-url" content="{{ env.pbUrl }}" />{% endif %}
  <link rel="stylesheet" href="https://startr.style/style.css" />
  <style>
    :root {
      /* Level + step-label palette, oklch */
      --c-beginner: oklch(65% 0.15 145);
      --c-intermediate: oklch(70% 0.14 85);
      --c-advanced: oklch(55% 0.18 25);
      --c-we: oklch(60% 0.14 250);
      --c-manually: oklch(60% 0.15 45);
      --c-delegate: oklch(55% 0.13 305);
      --c-ink: oklch(22% 0.02 250);
      --c-paper: oklch(98% 0.005 90);
    }
  </style>
</head>
