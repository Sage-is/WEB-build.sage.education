<style>
  :root {
    /* Level + step-label palette, oklch. Each holds 5:1 or better under
       white chip text (WCAG AA is 4.5:1). */
    --c-beginner: oklch(52% 0.13 145);
    --c-intermediate: oklch(52% 0.08 200);
    --c-advanced: purple;
    --c-we: oklch(53% 0.14 250);
    --c-manually: oklch(55% 0.15 45);
    --c-delegate: oklch(55% 0.13 305);
    --c-ink: oklch(22% 0.02 250);
    --c-paper: oklch(98% 0.005 90);
    /* Surfaces: card borders, quiet panels, finished work. */
    --c-line: oklch(88% 0.01 250);
    --c-panel: oklch(96% 0.005 90);
    --c-done: oklch(52% 0.13 145);
    --c-done-bg: oklch(97% 0.02 145);
    /* Certificate ornament gold, matching the stroke in assets/brand/deco-*.svg. */
    --c-deco: #9a7b3c;
  }
  /* startr.style footgun: an inline --d (display: var(--d) !important) and
     its own button display both beat the browser's [hidden] rule, so
     progress.js could not hide a goal strip or a button. Same specificity,
     later in the cascade, so this wins. Upstream card: WEB-startr.style.core
     TODO, "ship [hidden] { display:none !important } in base". */
  [hidden] { display: none !important; }
</style>
