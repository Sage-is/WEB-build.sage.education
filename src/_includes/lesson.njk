---
layout: default
---
{% set o = lesson.overlay %}
{% set e = lesson.entry %}
<article data-lesson="{{ o.slug }}" data-level="{{ o.level }}" data-title="{{ o.title }}"
         data-time-estimate="{{ o.timeEstimate }}" data-source-hash="{{ o.sourceHash }}">
  <header>
    <p style="--d:flex; --g:0.5rem; --fw:wrap; --size:0.8rem">
      <span style="{{ ui.chip }}; --bg:var(--c-{{ o.level }}); --size:0.8rem">{{ o.level }}</span>
      <span style="{{ ui.tag }}">{{ taxonomy.timeLabels[o.timeEstimate] }}</span>
      <span style="{{ ui.tag }}">{{ e.category }}</span>
    </p>
    <h1 style="--size:1.6rem; --size-md:2.1rem; --d:flex; --ai:flex-start; --g:0.7rem; --p:1rem; --bg:var(--c-panel); --radius:0.5rem; --lh:1.2">
      {% if lesson.icon %}<img src="{{ lesson.icon }}" alt="" width="36" height="36" style="--radius:0.4rem; --mt:0.2rem" />{% endif %}
      <span>{{ o.title | titleBreak | safe }}</span>
    </h1>
    <p>{{ o.summary }}</p>
    <section data-goal style="{{ ui.panel }}; --size:0.9rem">
      <p data-goal-text style="--m:0">Tick a step below to start. Your progress stays in this browser.</p>
      <p style="--m:0.6rem 0 0"><button type="button" data-start hidden style="{{ ui.button }}">Start this build</button></p>
      <div data-goal-controls hidden style="--d:flex; --fw:wrap; --g:0.4rem; --ai:center; --mt:0.6rem; --size:0.85rem">
        <span>Set your goal:</span>
        <button type="button" data-goal-preset="today" style="--p:0.2rem 0.6rem">today</button>
        <button type="button" data-goal-preset="weekend" style="--p:0.2rem 0.6rem">this weekend</button>
        <button type="button" data-goal-preset="7" style="--p:0.2rem 0.6rem">1 week</button>
        <button type="button" data-goal-preset="14" style="--p:0.2rem 0.6rem">2 weeks</button>
        <button type="button" data-goal-preset="30" style="--p:0.2rem 0.6rem">1 month</button>
        <label style="--d:flex; --ai:center; --g:0.4rem">or a date <input type="date" data-goal-date style="--p:0.2rem" /></label>
      </div>
    </section>
  </header>

  <section>
    <h2 style="{{ ui.h2 }}">What you'll learn</h2>
    <ul>
      {% for item in o.whatYoullLearn %}<li>{{ item }}</li>{% endfor %}
    </ul>
    {% if o.prerequisites.length %}
    <h2 style="{{ ui.h2 }}">Before you start</h2>
    <ul>
      {% for item in o.prerequisites %}<li>{{ item }}</li>{% endfor %}
    </ul>
    {% endif %}
  </section>

  <section>
    <h2 style="{{ ui.h2 }}; --d:flex; --fw:wrap; --ai:baseline; --g:0.2rem 0.8rem">
      The build
      <span style="--size:0.85rem; --weight:400">
        <span data-progress-counter></span>
        <a data-progress-next hidden href="#step-0"></a>
      </span>
    </h2>
    <div role="progressbar" aria-label="Build progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
         style="--h:0.5rem; --bg:var(--c-line); --radius:1rem; --of:hidden; --mb:1rem">
      <div data-progress-bar style="--w:0%; --h:100%; --bg:var(--c-done)"></div>
    </div>
    <p data-progress-reset hidden style="{{ ui.note }}">This lesson changed since you last ticked it, so your earlier ticks were cleared. A finished lesson still counts.</p>
    <p data-storage-warning hidden style="{{ ui.note }}">This browser is not saving progress, perhaps because of private browsing. Ticks will be gone when you close the tab.</p>
    {% for step in o.steps %}
      {% set labelMeta = taxonomy.labels[step.label] %}
      {% set index = loop.index0 %}
      {% set slug = o.slug %}
      {% include "component/step.njk" %}
    {% endfor %}
  </section>

  <section>
    <h2 style="{{ ui.h2 }}">Where things stand</h2>
    <ul>
      {% for item in o.whatYouWontGet %}<li>{{ item }}</li>{% endfor %}
    </ul>
    <h2 style="{{ ui.h2 }}">Why people pay for the original and what that teaches us</h2>
    {% for m in o.moatLessons %}
    <p><strong>{{ m.tag }}:</strong> {{ m.lesson }}</p>
    {% endfor %}
    {% if o.stretchGoals.length %}
    <h2 style="{{ ui.h2 }}">Stretch goals</h2>
    <p style="{{ ui.note }}">Optional. Tick the ones you finish; three of them, on any builds, earn a badge.</p>
    <ul style="--lis:none; --p:0">
      {% for item in o.stretchGoals %}
      <li style="--mb:0.5rem">
        <label style="--d:flex; --ai:flex-start; --g:0.6rem; --cur:pointer">
          <input type="checkbox" data-stretch="{{ o.slug }}:{{ loop.index0 }}" style="--w:1.4rem; --h:1.4rem; --m:0.15rem 0 0; --cur:pointer" />
          <span>{{ item }}</span>
        </label>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>

  {% set slug = o.slug %}
  {% set level = o.level %}
  {% include "component/built-it.njk" %}

  <section style="{{ ui.panel }}; --mt:2rem; --size:0.9rem">
    {% if e.origin == "first-party" %}
    <h2 style="--size:1rem">About this project</h2>
    <p>{{ e.about }}</p>
    <p>
      {{ e.name }} is ours. Sage.Education builds and runs it, and this lesson was written from that build.
      It does not come from a <a href="{{ site.upstream.site }}">{{ site.upstream.name }}</a> entry.
      {% if e.repo %}The code is AGPL-3.0 at <a href="{{ e.repo }}" rel="noopener">{{ e.repo }}</a>.{% endif %}
    </p>
    {% else %}
    <h2 style="--size:1rem">About {{ e.name }}</h2>
    <p>
      {{ e.name }} costs ${{ e.priceMonthly }}/month.
      {{ e.whyPeopleStillPay }}
    </p>
    <p style="--size:0.8rem">
      Entry data from <a href="{{ site.upstream.site }}">{{ site.upstream.name }}</a>, licensed MIT.
    </p>
    {% endif %}
  </section>

  {% if o.resources.length or e.alternatives.length %}
  <section style="--size:0.9rem">
    <h2 style="{{ ui.h2 }}">Sources &amp; further reading</h2>
    <ul>
      {% for r in o.resources %}
      <li><a href="{{ r.url }}">{{ r.title }}</a>{% if r.note %} — {{ r.note }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% if e.alternatives.length %}
    <h3 style="--size:1rem">Finished alternatives (if you'd rather not build)</h3>
    <ul>
      {% for alt in e.alternatives %}
      <li><a href="{{ alt.url }}">{{ alt.name }}</a>{% if alt.desc %} — {{ alt.desc }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}

  {% include "component/newsletter.njk" %}
</article>
